@page "/health"
@inject IHttpClientFactory HttpClientFactory

<div class="health-page">
    @if (isLoading)
    {
        <p>Checking API status...</p>
    }
    else if (statusData.Count == 0)
    {
        <HealthSummary AllHealthy="false" />
        <p>Could not reach the Bored But Broke API.</p>
    }
    else
    {
        <HealthSummary AllHealthy="allHealthy" />

        <div class="health-grid">
            <HealthStautsList StatusData="statusData" />
        </div>
    }
</div>

@code {
    private Dictionary<string, string> statusData = new();
    private bool allHealthy;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var Http = HttpClientFactory.CreateClient("BBBBackEnd");
        try
        {
            using var httpResponse = await Http.GetAsync("/health");
            var response = await httpResponse.Content.ReadFromJsonAsync<HealthResponse>();

            statusData = response?.Checks?.FirstOrDefault()?.Data ?? new Dictionary<string, string>();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Health check failed: {ex.Message}");
            statusData = new Dictionary<string, string>();
        }

        allHealthy = statusData.Count > 0 && statusData.Values.All(v => v == "Healthy");
        isLoading = false;
    }
        public class HealthResponse
            {
                public string Status { get; set; } = "";
                public List<HealthCheck> Checks { get; set; } = new();
            }

        public class HealthCheck
            {
                public string Name { get; set; } = "";
                public Dictionary<string, string> Data { get; set; } = new();
            }

}
