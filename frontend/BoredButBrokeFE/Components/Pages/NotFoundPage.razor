@page "/404"

<HeadContent>
    <link rel="stylesheet" href="css/NotFoundPage.css" />
</HeadContent>


<div class="notfound-page">
    <div class="notfound-wrapper">

        <div class="notfound-illustration">
            <div class="notfound-bubble">404</div>
            <div class="notfound-browser">
                <div class="notfound-browser-bar">
                    <div class="notfound-browser-dot"></div>
                    <div class="notfound-browser-dot"></div>
                    <div class="notfound-browser-dot"></div>
                </div>
                <div class="notfound-browser-face">
                    <div class="notfound-browser-eyes">
                        <div class="notfound-browser-eye"></div>
                        <div class="notfound-browser-eye"></div>
                    </div>
                    <div class="notfound-browser-mouth"></div>
                </div>
            </div>
            <div class="notfound-browser-shadow"></div>
        </div>

        <div class="notfound-title">Page Not Found</div>
        <p class="notfound-text">
            We looked everywhere for this page.<br />
            Are you sure the website URL is correct?<br />
        </p>
        <a class="notfound-button" href="/">Go Back Home</a>

    </div>

</div>

